:root {
    --bg-main: #f0f2f5;
    --bg-card: #ffffff;
    --text-title: #1e293b;
    --text-body: #475569;
    --primary: #0284c7;
    --primary-light: #e0f2fe;
    --primary-hover: #0369a1;
    --success: #16a34a;
    --danger: #dc2626;
    --border: #cbd5e1;
    --input-bg: #f8fafc;
    --shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.08);
}

[data-theme="dark"] {
    --bg-main: #090d16;
    --bg-card: #111827;
    --text-title: #f8fafc;
    --text-body: #94a3b8;
    --primary: #38bdf8;
    --primary-light: #0c4a6e;
    --primary-hover: #7dd3fc;
    --border: #374151;
    --input-bg: #1f2937;
    --shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.5);
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', system-ui, sans-serif;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
}

body {
    background-color: var(--bg-main);
    color: var(--text-body);
    min-height: 100vh;
}

/* LAYOUT UTAMA: SPLIT-SCREEN COOPERATIVE */
.layout-container {
    display: grid;
    grid-template-columns: 1fr;
    min-height: 100vh;
}

@media (min-width: 992px) {
    .layout-container {
        grid-template-columns: 360px 1fr;
    }
}

/* SISI KIRI: STICKY FORM PANEL */
.sidebar-panel {
    background-color: var(--bg-card);
    border-right: 1px solid var(--border);
    padding: 30px 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
}

@media (min-width: 992px) {
    .sidebar-panel {
        position: sticky;
        top: 0;
        height: 100vh;
        overflow-y: auto;
    }
}

.brand-header h1 {
    font-size: 1.35rem;
    color: var(--text-title);
    font-weight: 800;
}

.brand-header p {
    font-size: 0.85rem;
    color: var(--text-body);
    margin-top: 4px;
}

.form-title {
    font-size: 1.1rem;
    color: var(--primary);
    font-weight: 700;
    margin-top: 10px;
}

.field-block {
    margin-bottom: 12px;
}

.input-item {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--border);
    background-color: var(--input-bg);
    color: var(--text-title);
    border-radius: 8px;
    font-size: 0.9rem;
}

.input-item:focus {
    outline: none;
    border-color: var(--primary);
}

.error-message {
    color: #ef4444;
    font-size: 0.75rem;
    margin-top: 4px;
    font-weight: 500;
}

.btn-full {
    width: 100%;
    padding: 12px;
    border: none;
    border-radius: 8px;
    font-weight: 700;
    cursor: pointer;
    font-size: 0.95rem;
    margin-top: 6px;
}

.btn-save { background-color: var(--primary); color: white; }
.btn-save:hover { background-color: var(--primary-hover); }
.btn-cancel { background-color: transparent; border: 1px solid var(--border); color: var(--text-body); }
.btn-cancel:hover { background-color: var(--input-bg); }

/* SISI KANAN: LIVE VIEW & METRICS */
.content-panel {
    padding: 30px 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.top-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.theme-toggle-btn {
    background-color: var(--bg-card);
    border: 1px solid var(--border);
    padding: 8px 16px;
    border-radius: 20px;
    cursor: pointer;
    color: var(--text-title);
    font-size: 0.85rem;
    font-weight: 600;
    box-shadow: var(--shadow);
}

/* Grid Statistik Gabungan */
.metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
}

.metric-card {
    background-color: var(--bg-card);
    padding: 16px;
    border-radius: 12px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
}

.metric-card p { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: var(--text-body); }
.metric-card h3 { font-size: 1.6rem; color: var(--text-title); margin-top: 2px; }

/* Search & Filter Hub */
.filter-control-hub {
    background-color: var(--bg-card);
    padding: 14px;
    border-radius: 12px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
}

@media (min-width: 600px) {
    .filter-control-hub {
        grid-template-columns: 2fr 1fr 1fr;
    }
}

/* Tabel Responsif & Badge */
.table-container {
    background-color: var(--bg-card);
    border-radius: 12px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.9rem;
}

th {
    background-color: var(--bg-card);
    color: var(--text-body);
    font-weight: 700;
    padding: 14px 16px;
    border-bottom: 2px solid var(--border);
    font-size: 0.8rem;
    text-transform: uppercase;
}

td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
    color: var(--text-title);
}

tr:last-child td { border-bottom: none; }
tr:hover td { background-color: var(--primary-light); }

.gender-badge {
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #fff;
}
.badge-l { background-color: #2563eb; }
.badge-p { background-color: #db2777; }

.action-links {
    display: flex;
    gap: 12px;
}

.action-links a {
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--primary);
}
.action-links a.delete-btn { color: var(--danger); }
.action-links a:hover { text-decoration: underline; }

/* Paginasi */
.pagination-container {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 10px;
}

.pagination-container button {
    background-color: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text-title);
    padding: 8px 14px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 500;
}

.pagination-container button.active {
    background-color: var(--primary);
    color: white;
    border-color: var(--primary);
}
